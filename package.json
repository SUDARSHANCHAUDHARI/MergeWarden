{
  "name": "merge-warden",
  "version": "0.1.0",
  "private": true,
  "description": "Profile-aware GitHub PR housekeeping for Codex and Claude Code.",
  "author": "Sudarshan Chaudhari / SudarshanTechLabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SUDARSHANCHAUDHARI/MergeWarden.git"
  },
  "homepage": "https://github.com/SUDARSHANCHAUDHARI/MergeWarden#readme",
  "bugs": "https://github.com/SUDARSHANCHAUDHARI/MergeWarden/issues",
  "keywords": ["github", "pull-request", "codex", "claude-code", "automation", "developer-tools"],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mergewarden": "dist/src/cli.js"
  },
  "files": ["dist/", "plugins/", "scripts/", "scheduler/", "config/", "docs/", "README.md", "LICENSE", "SECURITY.md", "CONTRIBUTING.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm build && tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "validate": "node scripts/validate-package.mjs",
    "pack:check": "pnpm pack --pack-destination .mergewarden/package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.7.2"
  }
}
