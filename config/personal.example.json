{
  "profile": "personal",
  "githubAccount": "your-github-user",
  "gitEmail": "you@example.com",
  "repositoryRoots": ["/path/to/personal/repos"],
  "repositoryAllowlist": ["your-github-user/example"],
  "candidateBranches": { "your-github-user/example": [] },
  "verificationCommands": { "your-github-user/example": [["npm", "test"]] },
  "autoOpenPullRequests": true,
  "autoMergeLowRisk": true,
  "requireMergeApproval": false,
  "mergeMethod": "squash",
  "riskThreshold": 30,
  "requireReview": false,
  "scheduledApply": false,
  "deleteBranchAfterMerge": false,
  "auditLogPath": ".mergewarden/audit.jsonl"
}
